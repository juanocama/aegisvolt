# Rendered by Terraform for workspace ${environment}. Replaces the add-on's
# default application-log.conf so AegisVolt workloads log to per-environment,
# per-service groups /aegisvolt/${environment}/<app label> (spec 2.5); other
# namespaces keep the Container Insights application group.
[INPUT]
    Name                tail
    Tag                 aegisvolt.*
    Path                /var/log/containers/*_aegisvolt_*.log
    multiline.parser    docker, cri
    DB                  /var/fluent-bit/state/flb_aegisvolt.db
    Mem_Buf_Limit       50MB
    Skip_Long_Lines     On
    Refresh_Interval    10
    Rotate_Wait         30
    storage.type        filesystem
    Read_from_Head      $${READ_FROM_HEAD}

[INPUT]
    Name                tail
    Tag                 application.*
    Path                /var/log/containers/*.log
    Exclude_Path        /var/log/containers/*_aegisvolt_*.log, /var/log/containers/cloudwatch-agent*, /var/log/containers/fluent-bit*, /var/log/containers/aws-node*, /var/log/containers/kube-proxy*
    multiline.parser    docker, cri
    DB                  /var/fluent-bit/state/flb_container.db
    Mem_Buf_Limit       50MB
    Skip_Long_Lines     On
    Refresh_Interval    10
    Rotate_Wait         30
    storage.type        filesystem
    Read_from_Head      $${READ_FROM_HEAD}

[FILTER]
    Name                kubernetes
    Match               aegisvolt.*
    Kube_URL            https://kubernetes.default.svc:443
    Kube_Tag_Prefix     aegisvolt.var.log.containers.
    Merge_Log           On
    Merge_Log_Key       log_processed
    K8S-Logging.Parser  On
    K8S-Logging.Exclude Off
    Labels              On
    Annotations         Off
    Use_Kubelet         On
    Kubelet_Port        10250
    Buffer_Size         0

[FILTER]
    Name                kubernetes
    Match               application.*
    Kube_URL            https://kubernetes.default.svc:443
    Kube_Tag_Prefix     application.var.log.containers.
    Merge_Log           On
    Merge_Log_Key       log_processed
    K8S-Logging.Parser  On
    K8S-Logging.Exclude Off
    Labels              Off
    Annotations         Off
    Use_Kubelet         On
    Kubelet_Port        10250
    Buffer_Size         0

[OUTPUT]
    Name                cloudwatch_logs
    Match               aegisvolt.*
    region              $${AWS_REGION}
    log_group_name      /aegisvolt/${environment}/other
    log_group_template  /aegisvolt/${environment}/$kubernetes['labels']['app']
    log_stream_prefix   $${HOST_NAME}-
    log_stream_template $kubernetes['pod_name'].$kubernetes['container_name']
    auto_create_group   false
    extra_user_agent    container-insights

[OUTPUT]
    Name                cloudwatch_logs
    Match               application.*
    region              $${AWS_REGION}
    log_group_name      /aws/containerinsights/$${CLUSTER_NAME}/application
    log_stream_prefix   $${HOST_NAME}-
    auto_create_group   false
    extra_user_agent    container-insights
